# Copy to .env and edit. Every value here is the built-in default, so an empty .env
# gives you a fully local, zero-API-key system.

# --- core ---
RE_ENV=dev
RE_SEED=42
RE_LOG_LEVEL=INFO
RE_LOG_JSON=true

# --- paths ---
RE_DATA_DIR=data
RE_EVAL_RESULTS_DIR=eval_results

# --- embedding (local, no key needed) ---
RE_EMBEDDER=local
RE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RE_EMBEDDING_DIMENSION=384
RE_EMBEDDING_BATCH_SIZE=32
RE_NORMALIZE_EMBEDDINGS=true
# The bge query-side instruction. Applied to queries only, never to passages.
RE_USE_QUERY_INSTRUCTION=true

# --- reranking ---
RE_RERANKER_MODEL=BAAI/bge-reranker-base
RE_RERANKER_BATCH_SIZE=16
RE_RERANKER_CACHE_SIZE=10000

# --- vector store ---
# pgvector for real use, memory for tests and quick local runs.
RE_STORE=pgvector
RE_COLLECTION=default
RE_POSTGRES_DSN=postgresql://retrieval:retrieval@localhost:5432/retrieval
RE_HNSW_M=16
RE_HNSW_EF_CONSTRUCTION=64

# --- chunking ---
RE_CHUNK_STRATEGY=recursive_structural
RE_CHUNK_SIZE=512
RE_CHUNK_OVERLAP=64
RE_CHUNK_MIN_TOKENS=96
RE_SEMANTIC_THRESHOLD_PERCENTILE=95.0

# --- ingestion ---
RE_INGEST_CONCURRENCY=4

# --- generation ---
# ollama by default; if the server is unreachable the service answers extractively
# rather than failing, so this never has to be running.
RE_LLM=ollama
RE_OLLAMA_BASE_URL=http://localhost:11434
RE_OLLAMA_MODEL=llama3.1:8b
RE_GENERATION_TEMPERATURE=0.0
RE_GENERATION_MAX_TOKENS=512

# --- guardrails ---
RE_GROUNDING_THRESHOLD=0.55
RE_MIN_CONFIDENCE=0.3
RE_MIN_SOURCES=1

# --- api ---
RE_API_HOST=0.0.0.0
RE_API_PORT=8000
RE_RATE_LIMIT_ENABLED=true
RE_RATE_LIMIT_PER_MINUTE=60

# --- retrieval (nested: double underscore) ---
RE_RETRIEVAL__TOP_K_DENSE=50
RE_RETRIEVAL__TOP_K_LEXICAL=50
RE_RETRIEVAL__FUSION=rrf
RE_RETRIEVAL__RRF_K=60
RE_RETRIEVAL__USE_RERANK=true
RE_RETRIEVAL__RERANK_CANDIDATES=20
RE_RETRIEVAL__FINAL_TOP_K=5
RE_RETRIEVAL__EXPANSION=none

# --- optional remote embedder (leave unset for the local default) ---
# The embedder is the only remote backend. Generation is local Ollama with an
# extractive fallback, so RE_LLM accepts only "ollama" or "extractive".
# RE_OPENAI_API_KEY=sk-...
# RE_EMBEDDER=openai
# RE_EMBEDDING_DIMENSION=1536
